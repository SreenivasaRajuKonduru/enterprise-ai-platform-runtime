{
  "id": null,
  "uid": "enterprise-ai-platform-overview",
  "title": "Enterprise AI Platform Runtime Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Total HTTP Requests",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(http_requests_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Requests / Second",
      "id": 2,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Average Response Time",
      "id": 3,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum[5m])) / sum(rate(http_request_duration_seconds_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Errors",
      "id": 4,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Traffic by API Instance",
      "id": 5,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(instance) (rate(http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    }
  ]
}